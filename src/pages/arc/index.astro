---
// Switching from Arc: the one page written for Arc users (TASK-292.3).
// Arc facts come from Arc's own help center, read through the Wayback
// Machine (resources.arc.net refuses scripted fetches); see
// docs/feature-pages.md. Detour's names link to their guide pages as soon as
// those pages exist. The migration section follows the importer's own words
// (File › Import from Arc…, TASK-293; strings in the app's
// Detour/Import/Arc/ArcImportText.swift and ArcImportWindowController.swift).
import { getCollection } from "astro:content";
import Arrow from "../../components/Arrow.astro";
import Base from "../../layouts/Base.astro";
import { inline } from "../../lib/inline";

const pages = new Set((await getCollection("features")).map((f) => f.id));
const featureLink = (id: string | null) => (id && pages.has(id) ? `/features/${id}/` : null);

// Arc's name, Detour's name, the guide page id Detour's will live at, and a note.
const mapping: { arc: string; detour: string; id: string | null; note: string }[] = [
  { arc: "Spaces", detour: "Spaces", id: "spaces", note: "Each Space has its own tabs, pinned tabs, emoji and color. Swipe over the sidebar to switch. Click **+** at the bottom of the sidebar to make one, choosing its name, emoji, color and Profile right there in the sidebar." },
  { arc: "Profiles", detour: "Profiles", id: "profiles", note: "Each Space uses a Profile for its logins, cookies, history and extensions. Favorites belong to the Profile, so every Space on it shows the same ones." },
  { arc: "Pinned tabs and folders", detour: "Pinned Tabs & Folders", id: "pinned-tabs", note: "Pin with [[⌘D]]. Closing a pinned tab keeps it in place, and clicking it again loads the address you pinned." },
  { arc: "Favorites", detour: "Favorites", id: "favorites", note: "Icon tiles at the top of the sidebar, shared by every Space on a Profile. Drag a tab onto them to add one." },
  { arc: "Split View", detour: "Split Tabs", id: "split-tabs", note: "Two tabs side by side as one sidebar row. Arc also allowed more panes and stacked splits." },
  { arc: "Little Arc", detour: "Quick Detour", id: "quick-detour", note: "[[⌥⌘N]] from any app opens a one-page window, the same keys as Little Arc. **Open in** moves the page into a Space; unused windows close after 6 hours by default." },
  { arc: "Air Traffic Control", detour: "Link Routes", id: "link-routes", note: "Send links to a Space by their address and, unlike Arc, by the app they came from. Set up in **Settings › Links**." },
  { arc: "Command Bar", detour: "Command Palette", id: "command-palette", note: "[[⌘T]] for a new tab, [[⌘L]] to go somewhere in this tab. It finds open tabs, history and searches, but doesn't run commands the way Arc's did." },
  { arc: "Site Search", detour: "Site Search", id: "site-search", note: "Type a site's keyword and press Tab. Sites that offer their own search add themselves." },
  { arc: "Peek", detour: "Peek", id: "peek", note: "Links to other sites from pinned tabs and favorites open in a Peek, and Shift-click peeks any link." },
  { arc: "Auto Archive", detour: "Tab Archiving", id: "tab-archiving", note: "Idle tabs archive after 12 hours by default, set per Profile. Closed and archived tabs wait on the Archived Tabs page (**Navigate › Show Archived Tabs**)." },
  { arc: "Tab Switcher", detour: "Recent Tabs", id: "recent-tabs", note: "[[⌃Tab]] flips to the tabs you used last, and [[⌥⌘↑]] / [[⌥⌘↓]] walk the sidebar in order, as in Arc." },
  { arc: "Developer Mode", detour: "Dev Mode", id: "dev-mode", note: "Turns on by itself for localhost, with a toolbar for the console, network, an element picker and screenshots." },
  { arc: "Extensions", detour: "Web Extensions", id: "web-extensions", note: "Install from the Chrome Web Store with **Extensions › Add Extensions…**. Detour runs on WebKit, so some Chrome extensions work and some don't yet. 1Password works." },
  { arc: "Mini Player", detour: "Now-playing bar", id: null, note: "Audio and video you left playing in another tab get controls at the bottom of the sidebar." },
];

const notInDetour = [
  "**Sync** between computers, and the Arc Search app on iPhone.",
  "**Boosts**, **Easels**, **Notes** and **Arc Max**'s AI features.",
  "**Live Folders** and **Previews** of mail, calendars and other apps when you hover a tab. Detour's hover cards show the title, address and a picture of the page.",
  "**Sharing** a Space, folder or split as a link.",
  "**Themes** with gradients. A Space has one color.",
  "Shortcuts that jump to a Space by number ([[⌃1]], [[⌃2]]…). Use [[⌥⌘→]] and [[⌥⌘←]] or the **Spaces** menu.",
  "Splits of more than two tabs, and stacked splits.",
  "A built-in password manager, and importing from browsers other than Arc.",
  "Versions for Windows or iPhone. Detour is a Mac app.",
];

const notInArc = [
  "[**Quarantine**](/features/quarantine/): open links you don't trust in a throwaway window that has none of your cookies and keeps no history, then move the page into a Space if it turns out to be worth keeping.",
  "**Link Routes by app**: send links from Slack to Work and from Messages to Personal, or straight to a Private window, Quarantine or Quick Detour.",
  "**No account.** Arc needed one to sign in; Detour has nothing to sign up for, and your tabs and settings stay on your Mac.",
];

const faq = [
  { q: "When does Arc stop working?", a: "The Browser Company is sunsetting Arc on December 22, 2026. After that, Arc for Mac stops opening, so you can't get to your Spaces and tabs in it." },
  { q: "Can I import my Arc Spaces and pinned tabs?", a: "Yes. Choose **File › Import from Arc…** in Detour. It brings over your Spaces, pinned tabs and folders, Favorites, unpinned tabs and the last 90 days of history, from Arc on your Mac or from Arc's export file. Logins, passwords and extensions don't come across." },
  { q: "What if I don't import before Arc shuts down?", a: "Save Arc's export file now (**Arc › Settings › Advanced › Export Data**) and keep it. Detour can import it any time, even after Arc stops working, though it carries only links: no profiles, emoji, colors or history." },
  { q: "Is Detour built on Chromium like Arc?", a: "No. Detour is a native Mac app built on WebKit, the engine Safari uses. You can still install extensions from the Chrome Web Store; many work, and some don't yet." },
  { q: "Do I need an account?", a: "No. There's nothing to sign up for. Your tabs, Spaces and settings stay on your Mac." },
  { q: "Does Detour sync between Macs?", a: "Not yet." },
];

const url = (path: string) => new URL(path, Astro.site).href;
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Detour", item: url("/") },
    { "@type": "ListItem", position: 2, name: "Switching from Arc", item: url(Astro.url.pathname) },
  ],
};
---
<Base
  title="Switching from Arc: an Arc browser alternative for Mac | Detour"
  description="Arc stops working on December 22, 2026. Import your Arc Spaces, pinned tabs and Favorites into Detour, a free native Mac browser, and see how Arc's features carry over."
  imageAlt="Detour browser window showing the Spaces sidebar"
>
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs, null, 2)} />
</Fragment>

  <article class="guide" style="--accent:#FF7600">
    <Arrow class="bg-arrow bg-arrow-guide" />

    <header class="guide-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Detour</a><span aria-hidden="true">/</span><span aria-current="page">Switching from Arc</span>
      </nav>
      <span class="feature-label">FOR ARC USERS</span>
      <h1 class="guide-title">Switching from Arc</h1>
      <p class="guide-lede">Arc stops working on December 22, 2026. Here's how to bring your Arc setup into Detour, how Arc's features carry over, and what's different.</p>
    </header>

    <aside class="guide-callout" aria-label="Arc's shutdown date">
      <p><strong>Arc stops on December 22, 2026.</strong> The Browser Company announced on October 22 that Arc for Mac stops working that day and Arc accounts are closed. After that you can't open Arc to get to your Spaces and tabs. (<a href="https://arc.net/">Arc's announcement</a>)</p>
    </aside>

    <div class="guide-body">
      <h2 id="import">Bring your Arc setup over</h2>
      <p>Detour imports your Spaces, pinned tabs and folders, Favorites, unpinned tabs and history from Arc. It reads them straight from Arc on your Mac, or from the file Arc's <strong>Export Data</strong> saves.</p>

      <h3>Before December 22, in Arc</h3>
      <p>Importing from Arc on your Mac needs Arc's data to still be there, so do it before you remove Arc. Save an export file as well: Detour can import it any time, even after Arc stops working.</p>
      <ol>
        <li>Choose <strong>Arc › Settings</strong>, select <strong>Advanced</strong>, then <strong>Export Data</strong>. Arc saves a file called <strong>Arc Data Export.md</strong>. Keep it somewhere safe.</li>
        <li>If you saved passwords in Arc rather than in a password manager, export them too. Arc keeps them per Profile in its Chromium password settings (<strong>Arc › Settings › Profiles</strong>, then <strong>Password</strong>); import the file into Apple's Passwords app or the password manager you'll use with Detour.</li>
        <li>Note your Air Traffic Control routes (<strong>Arc › Settings › Links</strong>) so you can set them up again as Link Routes.</li>
      </ol>

      <h3>Import into Detour</h3>
      <p>When Detour finds Arc on your Mac, it offers once to bring your Arc setup along and shows your Spaces. <strong>Import Everything</strong> brings every Arc profile with everything in it. <strong>Choose…</strong> opens the import window so you can pick. You can also open that window yourself at any time:</p>
      <figure>
        <img src="/assets/features/arc-import-offer.webp" width="2280" height="1640" loading="lazy" alt="Detour's Import from Arc sheet over a browser window: the Arc and Detour app icons with an arrow between them, the heading Bring your Arc setup along, Detour found Arc on this Mac. Your spaces, pinned tabs and favorites can come with you. Six space chips in their Arc colors: Home, Work, Reading, Side Project, Travel and Recipes, then 6 spaces, 19 pinned tabs, 7 favorites, 90 days of history. Below: Logins, passwords and extensions stay in Arc. Arc stops working on December 22, 2026. Buttons: Not Now, Choose… and Import Everything.">
        <figcaption>The offer shows your own Arc Spaces before you import anything.</figcaption>
      </figure>
      <ol>
        <li>Choose <strong>File › Import from Arc…</strong>.</li>
        <li>Under <strong>Import from</strong>, choose <strong>Arc on this Mac</strong>, or choose <strong>An Arc export file</strong>, click <strong>Choose…</strong> and pick <strong>Arc Data Export.md</strong>.</li>
        <li>Each Arc profile is listed with its Spaces. Untick anything you don't want. Next to each profile, <strong>into</strong> says where it goes: a new Detour profile, or one you already have. A new profile takes the Arc profile's name, with "(Arc)" after it if Detour already has a profile by that name.</li>
        <li>Under <strong>Bring</strong>, choose any of <strong>Pinned tabs and folders</strong>, <strong>Favorites</strong>, <strong>Unpinned tabs</strong> and <strong>History (last 90 days)</strong>.</li>
        <li>Click <strong>Import</strong>. The window lists what was added.</li>
      </ol>
      <p>Spaces keep their names, emoji and colors, and pinned tabs stay in their folders, in Arc's order. A split of two tabs stays a split. Unpinned tabs come in asleep, so nothing loads until you click it.</p>
      <figure>
        <img src="/assets/features/arc-import-result.webp" width="2280" height="1640" loading="lazy" alt="The same sheet after Import Everything: a green check, Your Arc setup is in Detour, and a list: 2 new profiles, Personal (Arc) and Work (Arc); 6 new spaces, Home, Work, Reading, Side Project, Travel and Recipes; 19 pinned tabs in 5 new folders; 7 favorites; 2 unpinned tabs; Personal history: 12 visits added; Work history: 9 visits added. Behind it, the window has switched to the imported Home space, with its pinned tabs and a Weekend folder in the sidebar.">
        <figcaption>After the import, Detour lists what came over and opens your first imported Space.</figcaption>
      </figure>
      <p>Importing again is safe. Tabs, folders and Favorites Detour already has are left as they are, so you can import from Arc on your Mac today and from a later export file after that.</p>

      <h3>Importing an export file</h3>
      <p>An export file carries only links. Its Spaces are listed under one profile, Arc, and come in with their names but no emoji or colors. There is no history. It also doesn't say which links are Favorites: links at the top of two or more Spaces' Favorites lists become Favorites, and the rest, along with pinned tabs that aren't in a folder, come in as that Space's unpinned tabs.</p>

      <h3>What doesn't come across</h3>
      <p>Logins and cookies, saved passwords, extensions, Easels, Notes, Boosts and Little Arc windows stay in Arc. So do links that aren't web pages, such as <code>arc://</code> pages. The import window says what it left out. Then:</p>
      <ol>
        <li><strong>Sign in again.</strong> Sign in to your sites once in each Profile. If you use 1Password, install its extension (next step) and approve Detour in the 1Password app.</li>
        <li><strong>Add your extensions.</strong> Choose <strong>Extensions › Add Extensions…</strong> to open the Chrome Web Store, then click <strong>Add to Chrome</strong> on each extension.</li>
        <li><strong>Route your links.</strong> Recreate your Air Traffic Control routes in <strong>Settings › Links</strong>. Little Arc's <kbd>⌥⌘N</kbd> already opens Quick Detour.</li>
        <li><strong>Make Detour your browser.</strong> In <strong>Detour › Settings › General</strong>, click <strong>Set as Default Browser</strong>.</li>
      </ol>

      <h2 id="what-carries-over">What carries over</h2>
      <p>Most of what made Arc Arc has a counterpart in Detour, often working the same way and sometimes under a different name.</p>
      <table class="arc-map">
        <thead><tr><th>In Arc</th><th>In Detour</th><th>How it works in Detour</th></tr></thead>
        <tbody>
          {mapping.map((row) => {
            const href = featureLink(row.id);
            return (
              <tr>
                <td>{row.arc}</td>
                <td>{href ? <a href={href}>{row.detour}</a> : row.detour}</td>
                <td set:html={inline(row.note)} />
              </tr>
            );
          })}
        </tbody>
      </table>

      <h2 id="not-in-detour">What Arc had that Detour doesn't</h2>
      <ul>{notInDetour.map((item) => <li set:html={inline(item)} />)}</ul>

      <h2 id="not-in-arc">What Detour has that Arc didn't</h2>
      <ul>{notInArc.map((item) => <li set:html={inline(item)} />)}</ul>
      <p>A content blocker is built in too (EasyList, EasyPrivacy, cookie notices and malicious sites), with no extension to install.</p>

    </div>

    <section class="guide-faq" aria-labelledby="questions">
      <h2 id="questions">Questions</h2>
      {faq.map(({ q, a }) => (
        <div class="guide-faq-item">
          <h3>{q}</h3>
          <p set:html={inline(a)} />
        </div>
      ))}
    </section>
  </article>

</Base>
