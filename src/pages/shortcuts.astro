    rows: [
      ["Next Space", "[[⌥⌘→]]"],
      ["Previous Space", "[[⌥⌘←]]"],
    ],
  },
  {
    title: "Develop",
    id: "develop-menu",
    head: menuHead,
    rows: [["Web Inspector", "[[⌥⌘I]]"]],
