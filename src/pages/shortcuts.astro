---
// Keyboard Shortcuts (TASK-292.9): every shortcut in the released app, menu
// by menu in menu-bar order, then the keys that work outside the menus.
// Checked line by line against the release's code: the menus built in
// Detour/App/AppDelegate.swift (setupMainMenu, with the titles
// validateMenuItem shows), and the key handlers in RecentTabSwitcher,
// CommandPaletteView, FindBarView, ArchivePageView, the History page's script,
// QuickDetourWindowController and BrowserWindowController+Navigation (link
// clicks). Menu items without a shortcut are left out. Rows allow inline
// Markdown: keys as [[⌘T]], **bold** for control names.
import Arrow from "../components/Arrow.astro";
import Base from "../layouts/Base.astro";
import { inline } from "../lib/inline";

type Row = [string, string];
type Table = { title: string; id: string; note?: string; head: [string, string]; rows: Row[] };

