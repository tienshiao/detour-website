const url = (path: string) => new URL(path, Astro.site).href;
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Detour", item: url("/") },
    { "@type": "ListItem", position: 2, name: "Keyboard Shortcuts", item: url(Astro.url.pathname) },
  ],
};
---
<Base
  title="Keyboard shortcuts for the Detour browser on Mac | Detour"
  description="Every keyboard shortcut in Detour for Mac, menu by menu: tabs, Spaces, the command palette, ⌃Tab, Peek, split tabs, find in page and Quick Detour's ⌥⌘N."
  imageAlt="Detour browser window showing the Spaces sidebar"
>
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs, null, 2)} />
</Fragment>

  <article class="guide" style="--accent:#3E63DD">
    <Arrow class="bg-arrow bg-arrow-guide" />

    <header class="guide-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Detour</a><span aria-hidden="true">/</span><span aria-current="page">Keyboard Shortcuts</span>
      </nav>
      <span class="feature-label">KEYBOARD SHORTCUTS</span>
      <h1 class="guide-title">Keyboard Shortcuts</h1>
      <p class="guide-lede">Every key Detour knows: the menus first, in menu-bar order, then the keys that work outside them.</p>
    </header>

    <div class="guide-body shortcuts">
      <h2 id="menus">In the menus</h2>
      <p>The same keys are shown next to each item when you open the menu. Menu items without a shortcut, and the Extensions menu, which has none, aren't listed.</p>
      {menus.map((table) => (
        <section aria-labelledby={table.id}>
          <h3 id={table.id}>{table.title}</h3>
          <table>
            <thead><tr><th>{table.head[0]}</th><th>{table.head[1]}</th></tr></thead>
            <tbody>
              {table.rows.map(([what, keys]) => (
                <tr><td set:html={inline(what)} /><td set:html={inline(keys)} /></tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}

      <h2 id="elsewhere">Outside the menus</h2>
      <p>Keys that work in one place: the switcher, the command palette, a Peek, and the pages and windows below.</p>
      {elsewhere.map((table) => (
        <section aria-labelledby={table.id}>
          <h3 id={table.id}>{table.title}</h3>
          {table.note && <p set:html={inline(table.note)} />}
          <table>
            <thead><tr><th>{table.head[0]}</th><th>{table.head[1]}</th></tr></thead>
            <tbody>
              {table.rows.map(([what, keys]) => (
                <tr><td set:html={inline(what)} /><td set:html={inline(keys)} /></tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </article>

</Base>
