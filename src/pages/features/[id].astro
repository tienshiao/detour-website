---
// One guide page per Markdown file in src/content/features. The section order
// is fixed here so every page follows the template (docs/feature-pages.md):
// label, H1 + lede, media, the body (What it does, How to use it), Coming
// from Arc, Questions, Related, then the shared download footer.
import { getCollection, render } from "astro:content";
import Arrow from "../../components/Arrow.astro";
import Base from "../../layouts/Base.astro";
import { inline } from "../../lib/inline";

export async function getStaticPaths() {
  const features = await getCollection("features");
  return features.map((feature) => ({ params: { id: feature.id }, props: { feature, all: features } }));
}

const { feature, all } = Astro.props;
const { data } = feature;
const { Content } = await render(feature);

const related = data.related
  .map((id) => all.find((f) => f.id === id))
  .filter((f) => f !== undefined);

const url = (path: string) => new URL(path, Astro.site).href;
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Detour", item: url("/") },
    { "@type": "ListItem", position: 2, name: data.name, item: url(Astro.url.pathname) },
  ],
};

// Link the Switching from Arc hub only once it exists (TASK-292.3).
const hasArcHub = Object.keys(import.meta.glob("/src/pages/arc{.astro,/index.astro}")).length > 0;

const media = data.media;
const share = data.shareImage;
---
<Base
  title={data.title}
  description={data.description}
  image={share?.src}
  imageWidth={share?.width}
  imageHeight={share?.height}
  imageAlt={share?.alt ?? "Detour browser window showing the Spaces sidebar"}
>
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs, null, 2)} />
</Fragment>

  <article class="guide" style={`--accent:${data.accent}`}>
    <Arrow class="bg-arrow bg-arrow-guide" />

    <header class="guide-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Detour</a><span aria-hidden="true">/</span><span aria-current="page">{data.name}</span>
      </nav>
      <span class="feature-label">{data.label ?? data.name.toUpperCase()}</span>
      <h1 class="guide-title">{data.name}</h1>
      <p class="guide-lede">{data.lede}</p>
    </header>

    {media && (
      <figure class="guide-media">
        {media.type === "video" ? (
          <video class="feature-media" src={media.src} poster={media.poster} width={media.width} height={media.height} muted loop playsinline preload="none" aria-label={media.label}></video>
        ) : (
          <img class:list={["feature-media", media.width > media.height && "is-landscape"]} src={media.src} width={media.width} height={media.height} alt={media.alt} style={media.displayWidth ? `max-width:${media.displayWidth}px` : undefined} fetchpriority="high" />
        )}
        {media.caption && <figcaption>{media.caption}</figcaption>}
      </figure>
    )}

    <div class="guide-body">
      <Content />
    </div>

    {data.arc && (
      <section class="guide-arc" aria-labelledby="coming-from-arc">
        <h2 id="coming-from-arc">Coming from Arc</h2>
        <p class="guide-arc-intro">How Detour's {data.name} compares with Arc's {data.arc.arcName}.{hasArcHub && <> <a href="/arc/">Switching from Arc</a> covers the rest.</>}</p>
        <div class="guide-arc-grid">
          <div>
            <h3>The same</h3>
            <ul>{data.arc.same.map((item) => <li set:html={inline(item)} />)}</ul>
          </div>
          <div>
            <h3>Different</h3>
            <ul>{data.arc.different.map((item) => <li set:html={inline(item)} />)}</ul>
          </div>
          {data.arc.notInDetour.length > 0 && (
            <div>
              <h3>Not in Detour</h3>
              <ul>{data.arc.notInDetour.map((item) => <li set:html={inline(item)} />)}</ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="guide-faq" aria-labelledby="questions">
      <h2 id="questions">Questions</h2>
      {data.faq.map(({ q, a }) => (
        <div class="guide-faq-item">
          <h3>{q}</h3>
          <p set:html={inline(a)} />
        </div>
      ))}
    </section>

    {related.length > 0 && (
      <section class="guide-related" aria-labelledby="related">
        <h2 id="related">Related</h2>
        <ul>
          {related.map((f) => (
            <li>
              <a href={`/features/${f.id}/`} style={`--accent:${f.data.accent}`}>
                <span class="guide-related-name">{f.data.name}</span>
                <span class="guide-related-lede">{f.data.lede}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

</Base>
