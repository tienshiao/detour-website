---
import AppIcon from "./AppIcon.astro";
import { dmgUrl, version } from "../lib/release";

// On the home page the section links stay same-page anchors; elsewhere they
// lead back to the home page's sections.
const home = Astro.url.pathname === "/" ? "" : "/";
---
<header class="nav">
    <a class="brand" href={home ? "/" : "#top"}>
      <AppIcon />
      <span class="brand-name">Detour</span>
      <span class="version-pill">v{version} · pre-release</span>
    </a>
    <nav class="nav-links">
      <a href={`${home}#features`}>Features</a>
      <a href={`${home}#morefeatures`}>More Features</a>
      <a href="https://github.com/tienshiao/detour">GitHub</a>
    </nav>
    <a class="nav-download" href={dmgUrl}>Download .dmg</a>
  </header>
