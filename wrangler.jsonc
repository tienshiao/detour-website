{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detour-website",
  "compatibility_date": "2026-04-27",
  "observability": {
    "enabled": true
  },
  // `wrangler deploy` builds first, so a fresh clone deploys without a
  // separate build step (Cloudflare's Git build runs only npm ci + deploy).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
